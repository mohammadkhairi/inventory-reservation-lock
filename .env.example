# HTTP server port
PORT=3000

# Log level (fatal|error|warn|info|debug|trace). Defaults to info.
LOG_LEVEL=info

# development | production | test — controls pretty vs JSON pino output
NODE_ENV=development

# Required. Port 55432 matches docker-compose.yml (host-side) — non-default to
# avoid clashing with a local Postgres on 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/inventory

# Connection pool. Keep DB_POOL_MAX × replica count under Postgres max_connections.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_S=30
DB_MAX_LIFETIME_S=1800
DB_CONNECT_TIMEOUT_S=5

# Background expiry sweeper interval (ms). Correctness never depends on this —
# expired holds are treated as expired lazily by effectiveState. The sweeper
# only materializes ACTIVE→EXPIRED for audit visibility.
SWEEPER_INTERVAL_MS=30000
